#!/bin/bash
# Runs the checks a student needs before the exam. Prints ok / FAIL for each.
# Options (used by the automated build test): --skip-web, --skip-github
SKIP_WEB=0; SKIP_GITHUB=0
for a in "$@"; do case "$a" in --skip-web) SKIP_WEB=1;; --skip-github) SKIP_GITHUB=1;; esac; done
[ -f /etc/profile.d/hpc2n-shim.sh ] && . /etc/profile.d/hpc2n-shim.sh
pass=0; fail=0
ok()   { echo "  ok    $1"; pass=$((pass+1)); }
bad()  { echo "  FAIL  $1"; fail=$((fail+1)); }
DB=/proj/nobackup/cddb_course/databases/swissprot/swissprot

echo "Tools"
git --version >/dev/null 2>&1 && ok "$(git --version)" || bad "git missing"
command -v ssh >/dev/null && ok "ssh client present" || bad "ssh client missing"
command -v zip >/dev/null && ok "zip present" || bad "zip missing"

echo "Modules (imitated)"
if module load BLAST+/2.17.0 >/dev/null 2>&1; then bad "BLAST+ loaded without GCC and OpenMPI (it should not)"; else ok "BLAST+ alone is refused, as on Kebnekaise"; fi
module purge
module load GCC/14.2.0 OpenMPI/5.0.7 BLAST+/2.17.0 && ok "$(blastp -version | head -1)" || bad "blast module line"
module load GCCcore/14.3.0 git/2.50.1 cURL/8.14.1 && ok "git and cURL module line accepted" || bad "git module line"
blastdbcmd -db "$DB" -info >/dev/null 2>&1 && ok "database: $(blastdbcmd -db "$DB" -info | sed -n '2p' | sed 's/^[ \t]*//')" || bad "Swiss-Prot database not readable"

# One web service: up to 3 attempts, because a service can answer slowly or not at all for a moment (the EBI service did this).
# It passes if any attempt gives HTTP 200, and says so when it needed more than one attempt.
web_check() {
  local u="$1" n code why errf
  for n in 1 2 3; do
      errf=$(mktemp); code=$(curl -sS -o /dev/null -m ${WEB_CHECK_TIMEOUT:-20} -w '%{http_code}' "$u" 2>"$errf"); why=$(head -c 200 "$errf" | tr '\n' ' '); rm -f "$errf"
      [ "$code" = 200 ] && break
      [ $n -lt 3 ] && sleep ${WEB_CHECK_PAUSE:-2}
  done
  if [ "$code" = 200 ]; then
      if [ $n -eq 1 ]; then ok "HTTP $code  $u"; else ok "HTTP $code  $u  (answered only on attempt $n of 3: the service is slow or unstable at the moment)"; fi
  else
      bad "HTTP $code  $u  (no success in 3 attempts${why:+; last error: $why})"
      [ "$code" = 000 ] && echo "        HTTP 000 means that no answer came back: a network, firewall, VPN or DNS problem on your side or the service is down."
  fi
}

if [ $SKIP_WEB -eq 0 ]; then
  echo "Web services used in the exam"
  for u in "https://rest.uniprot.org/uniprotkb/P38398.fasta" \
           "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/einfo.fcgi" \
           "https://www.ebi.ac.uk/Tools/services/rest/ncbiblast/parameters"; do
      web_check "$u"
  done
fi

if [ $SKIP_GITHUB -eq 0 ]; then
  echo "Git and GitHub"
  [ -n "$(git config --global user.name)" ] && [ -n "$(git config --global user.email)" ] \
      && ok "git identity set" || bad "git name and e-mail not set yet (expected at first: run exam-practice-setup)"
  [ "$(git config --global init.defaultBranch)" = main ] && ok "init.defaultBranch is main" \
      || bad "Git default branch is not main yet (expected at first: run exam-practice-setup)"
  if ls ~/.ssh/id_*.pub >/dev/null 2>&1; then
      ok "SSH key present"
      res=$(ssh -T -o BatchMode=yes -o ConnectTimeout=15 git@github.com 2>&1)
      case "$res" in
          *"successfully authenticated"*) ok "GitHub accepted your key: $res";;
          *"Host key verification failed"*) bad "run  ssh -T git@github.com  once and answer yes, then re-run";;
          *) bad "GitHub did not accept the key: $res";;
      esac
  else
      bad "no SSH key yet (expected at first: run exam-practice-setup)"
  fi
fi

echo
echo "$pass ok, $fail FAIL"
if [ $SKIP_GITHUB -eq 0 ] && { [ -z "$(git config --global user.name)" ] || [ -z "$(git config --global user.email)" ] || ! ls ~/.ssh/id_*.pub >/dev/null 2>&1; }; then
    echo "The Git and GitHub lines are expected to fail until you have run exam-practice-setup."
    echo "Next: type  exam-practice-setup  and follow it, then run  exam-practice-check  again."
fi
[ $fail -eq 0 ]
